@{
    var pageTitle = !string.IsNullOrWhiteSpace(ViewBag.Title) ? ViewBag.Title + " - " : "";
    pageTitle += "Hệ Thống Thi TOEIC Reading";
    var currentPage = ViewBag.CurrentPageName as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@pageTitle</title>

    <!-- Google Font: Inter / Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Theme style -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .main-sidebar {
            background-color: #1e293b;
        }
        .brand-link {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .nav-sidebar .nav-link.active {
            background-color: #2563eb !important;
            color: #fff !important;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="Exam" asp-action="Index" class="nav-link font-weight-bold">Danh sách đề thi</a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="Exam" asp-action="Upload" class="nav-link font-weight-bold">Tải lên đề mới (.docx)</a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
            </ul>
        </nav>
        <!-- /.navbar -->

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a asp-controller="Exam" asp-action="Index" class="brand-link text-center d-block py-3">
                <span class="brand-text font-weight-bold text-white text-uppercase" style="letter-spacing: 1px;">
                    <i class="fas fa-graduation-cap text-primary mr-1"></i> TOEIC EXAM
                </span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-3">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-header text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">QUẢN TRỊ ĐỀ THI</li>
                        <li class="nav-item">
                            <a asp-controller="Exam" asp-action="Index" class="nav-link @(currentPage == "Exams" ? "active" : "")">
                                <i class="nav-icon fas fa-book-open"></i>
                                <p>Danh sách đề thi</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Exam" asp-action="Upload" class="nav-link @(currentPage == "UploadExam" ? "active" : "")">
                                <i class="nav-icon fas fa-cloud-upload-alt"></i>
                                <p>Tải lên đề thi (.docx)</p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            @RenderBody()
        </div>
        <!-- /.content-wrapper -->

        <!-- Main Footer -->
        <footer class="main-footer text-sm py-2">
            <div class="float-right d-none d-sm-inline">
                Đề tài kiểm tra giữa kỳ - TOEIC Reading Online
            </div>
            <strong>Hệ Thống Thi Trực Tuyến TOEIC Reading</strong> &copy; 2026.
        </footer>
    </div>
    <!-- ./wrapper -->

    <!-- REQUIRED SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
