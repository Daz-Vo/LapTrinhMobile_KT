@using ToeicExam.Exams.Dto
@model ExamDetailDto
@{
    ViewBag.Title = $"Xem trước & Biên tập Đề thi: {Model.Title}";
    ViewBag.CurrentPageName = "Exams";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1 class="m-0 text-dark font-weight-bold">
                    <i class="fas fa-file-signature text-primary mr-2"></i>@Model.Title
                </h1>
                <div class="mt-2 text-muted">
                    <span class="badge badge-primary mr-2"><i class="fas fa-list-ol mr-1"></i>@Model.TotalQuestions câu hỏi</span>
                    <span class="badge badge-info mr-2"><i class="far fa-clock mr-1"></i>@Model.DurationMinutes phút</span>
                    <span class="badge badge-secondary mr-2"><i class="fas fa-layer-group mr-1"></i>@(Model.Parts?.Count ?? 0) Phần (Parts)</span>
                </div>
            </div>
            <div class="col-sm-4 text-right align-self-center">
                <a asp-action="Index" class="btn btn-outline-secondary mr-2">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách đề
                </a>
                <a asp-action="Upload" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> Nhập thêm đề
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Part Tabs -->
        <div class="card card-primary card-outline card-outline-tabs shadow-sm">
            <div class="card-header p-0 border-bottom-0">
                <ul class="nav nav-tabs" id="partTab" role="tablist">
                    @for (int i = 0; i < (Model.Parts?.Count ?? 0); i++)
                    {
                        var part = Model.Parts[i];
                        <li class="nav-item">
                            <a class="nav-link @(i == 0 ? "active font-weight-bold" : "")" id="tab-part-@part.PartNumber" data-toggle="pill" href="#content-part-@part.PartNumber" role="tab">
                                <i class="fas fa-bookmark mr-1"></i>Part @part.PartNumber: @part.Name
                                <span class="badge badge-light border ml-1">@part.QuestionStart - @part.QuestionEnd</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="partTabContent">
                    @for (int i = 0; i < (Model.Parts?.Count ?? 0); i++)
                    {
                        var part = Model.Parts[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="content-part-@part.PartNumber" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded border">
                                <div>
                                    <h5 class="mb-0 text-primary font-weight-bold">
                                        Part @part.PartNumber: @part.Name
                                    </h5>
                                    <small class="text-muted">Phạm vi câu hỏi: Từ câu @part.QuestionStart đến câu @part.QuestionEnd</small>
                                </div>
                                <span class="badge badge-primary">@(part.Groups?.SelectMany(g => g.Questions)?.Count() ?? 0) câu hỏi</span>
                            </div>

                            @foreach (var group in part.Groups.OrderBy(g => g.OrderIndex))
                            {
                                <div class="card card-outline card-secondary mb-4 shadow-sm border-left-info">
                                    @if (!string.IsNullOrWhiteSpace(group.PassageText))
                                    {
                                        <div class="card-header bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0 font-weight-bold text-dark">
                                                    <i class="fas fa-file-alt text-info mr-2"></i>@(string.IsNullOrEmpty(group.GroupTitle) ? $"Đoạn văn nhóm ({group.GroupCode})" : group.GroupTitle)
                                                </h6>
                                                <span class="badge badge-secondary">@(group.Questions?.Count ?? 0) câu hỏi liên quan</span>
                                            </div>
                                        </div>
                                        <div class="card-body bg-white border-bottom">
                                            <div class="p-3 bg-light rounded border passage-display" style="white-space: pre-wrap; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; font-size: 0.95rem;">
@group.PassageText
                                            </div>
                                        </div>
                                    }

                                    <div class="card-body p-3">
                                        @foreach (var q in group.Questions.OrderBy(x => x.QuestionNumber))
                                        {
                                            <div class="question-item mb-4 p-3 rounded border bg-light shadow-xs" id="question-card-@q.Id">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="font-weight-bold text-dark mb-0">
                                                        <span class="badge badge-dark mr-2" style="font-size: 0.95rem;">Câu @q.QuestionNumber</span>
                                                        <span class="question-content-text">@q.Content</span>
                                                    </h6>
                                                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-question"
                                                            data-id="@q.Id"
                                                            data-number="@q.QuestionNumber"
                                                            data-content="@q.Content"
                                                            data-correct="@q.CorrectOption"
                                                            data-passage="@group.PassageText"
                                                            data-options='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(q.Options.ToDictionary(o => o.OptionLabel, o => o.Content)))'>
                                                        <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                                                    </button>
                                                </div>

                                                <!-- Options grid -->
                                                <div class="row mt-3">
                                                    @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                    {
                                                        bool isCorrect = string.Equals(opt.OptionLabel, q.CorrectOption, StringComparison.OrdinalIgnoreCase);
                                                        <div class="col-md-6 mb-2">
                                                            <div class="p-2 rounded border option-box @(isCorrect ? "bg-success text-white font-weight-bold border-success" : "bg-white")">
                                                                <span class="badge @(isCorrect ? "badge-light text-success" : "badge-secondary") mr-2 font-weight-bold">
                                                                    (@opt.OptionLabel)
                                                                </span>
                                                                <span class="option-content-@opt.OptionLabel">@opt.Content</span>
                                                                @if (isCorrect)
                                                                {
                                                                    <span class="float-right badge badge-light text-success"><i class="fas fa-check"></i> Đáp án đúng</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                @if (string.IsNullOrEmpty(q.CorrectOption))
                                                {
                                                    <div class="small text-danger font-italic mt-1">
                                                        <i class="fas fa-exclamation-circle mr-1"></i> Chưa xác định đáp án đúng cho câu này. Hãy bấm 'Chỉnh sửa' để chọn đáp án.
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Edit Question Modal -->
<div class="modal fade" id="editQuestionModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold" id="editModalLabel">
                    <i class="fas fa-edit mr-2"></i>Chỉnh sửa Câu hỏi & Đáp án
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editQuestionForm">
                    <input type="hidden" id="editQuestionId" />
                    
                    <div class="form-group" id="groupPassageContainer">
                        <label class="font-weight-bold">Đoạn văn đọc hiểu (Dành cho Part 6 / Part 7):</label>
                        <textarea class="form-control" id="editPassageText" rows="4"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Nội dung câu hỏi (Stem):</label>
                        <textarea class="form-control" id="editQuestionContent" rows="2" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold text-primary">Lựa chọn (A):</label>
                            <input type="text" class="form-control" id="editOptionA" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold text-primary">Lựa chọn (B):</label>
                            <input type="text" class="form-control" id="editOptionB" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold text-primary">Lựa chọn (C):</label>
                            <input type="text" class="form-control" id="editOptionC" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold text-primary">Lựa chọn (D):</label>
                            <input type="text" class="form-control" id="editOptionD" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-success">
                            <i class="fas fa-check-circle mr-1"></i>Đáp án đúng:
                        </label>
                        <select class="form-control custom-select" id="editCorrectOption">
                            <option value="">-- Chưa chọn đáp án --</option>
                            <option value="A">Đáp án (A)</option>
                            <option value="B">Đáp án (B)</option>
                            <option value="C">Đáp án (C)</option>
                            <option value="D">Đáp án (D)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success px-4" id="btnSaveQuestion">
                    <i class="fas fa-save mr-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-edit-question').on('click', function () {
                var $btn = $(this);
                var qId = $btn.data('id');
                var qNum = $btn.data('number');
                var qContent = $btn.data('content');
                var qCorrect = $btn.data('correct');
                var qPassage = $btn.data('passage');
                var qOptions = $btn.data('options') || {};

                $('#editQuestionId').val(qId);
                $('#editModalLabel').html('<i class="fas fa-edit mr-2"></i>Chỉnh sửa Câu ' + qNum);
                $('#editQuestionContent').val(qContent);
                $('#editPassageText').val(qPassage || '');
                if (!qPassage) {
                    $('#groupPassageContainer').hide();
                } else {
                    $('#groupPassageContainer').show();
                }

                $('#editOptionA').val(qOptions['A'] || '');
                $('#editOptionB').val(qOptions['B'] || '');
                $('#editOptionC').val(qOptions['C'] || '');
                $('#editOptionD').val(qOptions['D'] || '');
                $('#editCorrectOption').val(qCorrect || '');

                $('#editQuestionModal').modal('show');
            });

            $('#btnSaveQuestion').on('click', function () {
                var qId = parseInt($('#editQuestionId').val());
                var content = $('#editQuestionContent').val();
                var correctOption = $('#editCorrectOption').val();
                var passageText = $('#editPassageText').val();

                var options = {
                    'A': $('#editOptionA').val(),
                    'B': $('#editOptionB').val(),
                    'C': $('#editOptionC').val(),
                    'D': $('#editOptionD').val()
                };

                var payload = {
                    questionId: qId,
                    content: content,
                    correctOption: correctOption,
                    passageText: passageText,
                    options: options
                };

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang lưu...');

                $.ajax({
                    url: '@Url.Action("EditQuestion", "Exam")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thay đổi');
                        if (res.success) {
                            $('#editQuestionModal').modal('hide');
                            location.reload();
                        } else {
                            alert('Lỗi: ' + res.message);
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thay đổi');
                        alert('Đã xảy ra lỗi khi cập nhật: ' + xhr.responseText);
                    }
                });
            });
        });
    </script>
}
