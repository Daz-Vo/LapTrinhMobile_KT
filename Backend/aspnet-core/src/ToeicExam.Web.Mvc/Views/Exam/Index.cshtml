@using ToeicExam.Exams.Dto
@model List<ExamListDto>
@{
    ViewBag.Title = "Danh sách Đề thi TOEIC";
    ViewBag.CurrentPageName = "Exams";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark font-weight-bold"><i class="fas fa-book-open text-primary mr-2"></i>Quản lý Đề thi TOEIC</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a asp-action="Upload" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fas fa-cloud-upload-alt mr-1"></i> Tải lên đề thi mới (.docx)
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title font-weight-bold mb-0">Danh sách các bộ đề trong hệ thống</h3>
                <span class="badge badge-info p-2">Tổng số: @(Model?.Count ?? 0) đề thi</span>
            </div>
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-folder-open text-muted fa-4x mb-3"></i>
                        <h4 class="text-secondary font-weight-normal">Chưa có đề thi nào trong hệ thống</h4>
                        <p class="text-muted mb-4">Hãy tải lên file Word chứa đề thi TOEIC chuẩn định dạng XML để bắt đầu.</p>
                        <a asp-action="Upload" class="btn btn-outline-primary">
                            <i class="fas fa-upload mr-1"></i> Tải lên đề thi ngay
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 60px" class="text-center">#</th>
                                    <th>Tên Đề thi</th>
                                    <th class="text-center" style="width: 140px">Số câu hỏi</th>
                                    <th class="text-center" style="width: 140px">Thời gian làm bài</th>
                                    <th class="text-center" style="width: 130px">Lượt thi</th>
                                    <th class="text-center" style="width: 160px">Ngày tạo</th>
                                    <th class="text-center" style="width: 200px">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in Model)
                                {
                                    <tr>
                                        <td class="text-center font-weight-bold">@exam.Id</td>
                                        <td>
                                            <a asp-action="Preview" asp-route-id="@exam.Id" class="font-weight-bold text-dark text-decoration-none">
                                                <i class="fas fa-file-alt text-info mr-2"></i>@exam.Title
                                            </a>
                                            @if (!string.IsNullOrEmpty(exam.Description))
                                            {
                                                <div class="small text-muted">@exam.Description</div>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-success px-2 py-1"><i class="fas fa-list-ol mr-1"></i>@exam.TotalQuestions câu</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-secondary px-2 py-1"><i class="far fa-clock mr-1"></i>@exam.DurationMinutes phút</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-info px-2 py-1">@exam.TotalAttempts lượt</span>
                                        </td>
                                        <td class="text-center text-muted small">
                                            @exam.CreationTime.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="Preview" asp-route-id="@exam.Id" class="btn btn-sm btn-info mr-1" title="Xem chi tiết & Chỉnh sửa">
                                                <i class="fas fa-eye"></i> Xem & Sửa
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề thi này không? Tất cả câu hỏi và lịch sử làm bài sẽ bị xóa!');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đề thi">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
